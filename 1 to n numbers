            const n = parseInt(prompt("Enter Range"))
            i=1 //initiaization expression
            while(i<=n)  //conditional expression
        {
            document.writeln(i+"<br>")
            i++;  //increment operation     (update expression)
        }
        
        </script>
    </head>

